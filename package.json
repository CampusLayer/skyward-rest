{
  "name": "skyward-rest",
  "version": "2.0.0",
  "description": "Modern TypeScript client library for self-hosted Skyward integrations",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm test && npm run typecheck && npm run build"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "json5": "^2.2.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caleb-mau/skyward-rest.git"
  },
  "homepage": "https://github.com/caleb-mau/skyward-rest#readme",
  "bugs": {
    "url": "https://github.com/caleb-mau/skyward-rest/issues"
  },
  "keywords": [
    "skyward",
    "skyward-sms",
    "student-information-system",
    "sis",
    "typescript",
    "self-hosted",
    "education"
  ],
  "license": "MIT"
}
